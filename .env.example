# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.py
DEBUG=True

# Database
DATABASE_URL=sqlite:///eliberia_dev.db

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# CORS
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=DEBUG

# Dev only: return OTP codes in API responses
EXPOSE_OTP=True
# Email for one-time codes (leave blank locally; codes still go by SMS)
# Outbound mail uses the Resend HTTPS API when RESEND_API_KEY is set;
# SMTP below is only the fallback. The sender MAIL_FROM must be a domain
# verified in Resend (giin.co.rw, with Resend's DNS records added).
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=noreply@portagov.giin.co.rw
SMTP_PASS=
MAIL_FROM=noreply@portagov.giin.co.rw
PAYMENT_PROVIDER=mock
BIOMETRIC_PROVIDER=mock
